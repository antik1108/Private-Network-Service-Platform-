# dnsmasq - private DNS for @TEAM_DOMAIN@  (role: @DNS_ROLE@ resolver on @NODE_IP@)
#
# Rendered by scripts/render-configs.sh from team/team.env. Do not edit the
# rendered copy - edit the template / team.env and re-render.
#
# The SAME file runs on the primary (Mac 1) and the backup (Mac 2): both
# serve identical project records, which is what Extension A requires.

# ---- Listening -------------------------------------------------------------
# Port 53 on the wildcard address. On macOS an unprivileged process may bind a
# port < 1024 only on the wildcard address, so binding 0.0.0.0 lets dnsmasq
# run without sudo. Queries arrive on every interface (LAN + loopback).
port=53
bind-interfaces
listen-address=0.0.0.0

# ---- Project zone ----------------------------------------------------------
# Records live in a separate hosts file so they can be changed live:
# edit the file, send SIGHUP, and dnsmasq reloads it and clears its cache
# (used for the Extension B TTL demo and the Extension E edge cutover).
no-hosts
addn-hosts=@CN_HOME@/dnsmasq/teamX.hosts
# TTL that clients may cache our answers for (Extension B).
local-ttl=@DNS_TTL@
# Never forward project names to the Internet: unknown *.@TEAM_DOMAIN@ -> NXDOMAIN.
local=/@TEAM_DOMAIN@/
domain-needed
bogus-priv

# ---- Everything else is forwarded upstream ---------------------------------
no-resolv
no-poll
@UPSTREAM_SERVER_LINES@

# ---- Operations ------------------------------------------------------------
log-queries
log-facility=@CN_HOME@/logs/dnsmasq.log
pid-file=@CN_HOME@/run/dnsmasq.pid
cache-size=1000
