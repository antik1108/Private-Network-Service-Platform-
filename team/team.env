# Team network inventory - the single source of truth for every config.
#
# College Wi-Fi hands out addresses by DHCP, so these change whenever a
# laptop reconnects. At the start of EVERY session:
#   1. run scripts/get-my-ip.sh on each Mac
#   2. update the values below
#   3. run scripts/render-configs.sh   (regenerates config/rendered/*)
#   4. run scripts/deploy.sh           (pushes the bundle to every Mac)
#
# Last verified: 2026-11-25. Mac 3 is on Wi-Fi 192.168.1.0/24 (gateway 192.168.1.1);
# Macs 1 and 2 remain on the college LAN 10.7.0.0/19 (gateway 10.7.0.1).
# Mac 2 currently cannot initiate backend connections to Mac 3 across these networks.

TEAM_DOMAIN=teamX.test

# ---- Machines -------------------------------------------------------------
# Mac 1 - Tanmay Singh (2401010476): PRIMARY DNS (dnsmasq) + test client
MAC1_IP=10.7.6.8
MAC1_SSH=tanmaysingh@10.7.6.8
MAC1_DIR=/Users/tanmaysingh/Documents/Project/Capstones/CN_Project

# Mac 2 - Vansh Panwar (2401010494): PRIMARY EDGE (nginx) + BACKUP DNS (dnsmasq)
MAC2_IP=10.7.31.150
MAC2_SSH=vansh@10.7.31.150
MAC2_DIR=/Users/vansh/Desktop/Private-Network-Service-Platform-

# Mac 3/4 - Antik Mondal (2401010084): Backend A :3001 + Backend B :3002
#           + STANDBY EDGE (nginx, Extension E) + test client
MAC3_IP=192.168.1.188
MAC3_SSH=antikmondal@192.168.1.188
MAC3_DIR=/Users/antikmondal/Downloads/cn-starter

# ---- Roles (derived) -----------------------------------------------------
DNS1_IP=10.7.6.8          # primary resolver  (Mac 1)
DNS2_IP=10.7.31.150       # backup resolver   (Mac 2) - Extension A
EDGE1_IP=10.7.31.150      # primary edge      (Mac 2)
EDGE2_IP=192.168.1.188    # standby edge      (Mac 3/4) - Extension E
BACKEND_A=192.168.1.188:3001
BACKEND_B=192.168.1.188:3002

# Where app.teamX.test / api.teamX.test currently point (edge cutover changes this)
APP_RECORD_IP=10.7.31.150
DNS_TTL=30

# Upstream resolvers dnsmasq forwards non-project names to (college DNS, then Google)
UPSTREAM_DNS="10.5.7.1 8.8.8.8"
