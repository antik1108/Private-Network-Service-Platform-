# pf rules - Extension C: backend service isolation (runs on the backend Mac, @NODE_IP@)
#
# Loaded into the anchor "com.apple/cn-backend-isolation". The stock macOS
# /etc/pf.conf already evaluates every anchor under com.apple/*, so this adds
# our rules WITHOUT editing any system file. Rollback = flush this anchor.
#
#   apply:    sudo scripts/phase2/firewall.sh apply
#   status:   sudo scripts/phase2/firewall.sh status
#   rollback: sudo scripts/phase2/firewall.sh rollback

backend_ports = "{ 3001, 3002 }"
# Only the edge may talk to the backends.
edge_hosts    = "{ @EDGE1_IP@ }"

# Local traffic (the standby nginx on this same Mac reaches the backends over lo0).
pass in quick on lo0 all

# The edge (Mac 2) is allowed in to the backend ports.
pass in quick proto tcp from $edge_hosts to any port $backend_ports

# Everyone else is silently dropped: the client's SYN gets no reply, so the
# connection TIMES OUT (filtered). Compare with a stopped backend, which
# answers with RST -> "connection refused".
block drop in quick proto tcp from any to any port $backend_ports
